# Copy outside the repository, chmod 600, and point PAPERFORGE_ENV_FILE at it.
# Replace every CHANGE_ME value. DATABASE_URL must URL-encode its password.

POSTGRES_USER=paperforge
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=paperforge
DATABASE_URL=postgresql+asyncpg://paperforge:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/paperforge
PAPERFORGE_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777

REDIS_URL=redis://redis:6379/0
PAPERFORGE_REDIS_IMAGE=public.ecr.aws/docker/library/redis@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2

STORAGE_BACKEND=minio
STORAGE_FS_ROOT=/data/objects
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=paperforge
MINIO_SECURE=false
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
PAPERFORGE_MINIO_IMAGE=quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

LLM_DEFAULT_PROVIDER=noop
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_ROLE_MODELS={"planner":"gpt-4o-mini","extractor":"gpt-4o-mini","reranker":"gpt-4o-mini","writer":"gpt-4o","polisher":"gpt-4o","verifier":"gpt-4o-mini"}
LLM_ROLE_THINKING={"extractor":"disabled","reranker":"disabled"}
CARD_CONCURRENCY=6
QMATRIX_CONCURRENCY=4
# off | shadow | on. Keep `off` on first rollout; `shadow` costs one extractor call
# per paper (capped by MAX_WORKS) and changes nothing user-visible.
EXPERIMENT_EXTRACTION_MODE=off
EXPERIMENT_EXTRACTION_MAX_WORKS=20
EXPERIMENT_EXTRACTION_MAX_CHARS=60000
# all_tasks | generic_only. Unbound projects currently inherit every domain's
# whitelists; generic_only narrows them. Author task profiles with
# `paperforge-admin tasks upsert` before flipping.
TASK_PROFILE_FALLBACK=all_tasks

SCHOLAR_CONTACT_EMAIL=CHANGE_ME@example.com
SCHOLAR_USER_AGENT=PaperForge/0.1 (mailto:CHANGE_ME@example.com)
OPENALEX_API_KEY=

TEXD_URL=http://texd:8081
TEXD_TIMEOUT_SECONDS=120
VISUALS_ENABLED=true
AI_IMAGES_ENABLED=true
VISUALD_URL=http://visuald:8082
VISUALD_TIMEOUT_SECONDS=30
# Default provider. Yunwu's OpenAI-compatible Images API honours size and quality;
# YUNWU_* below is its configuration source. IMAGE_* configures every other provider.
IMAGE_PROVIDER=yunwu
YUNWU_API_BASE_URL=https://yunwu.ai/v1
YUNWU_API_KEY=
YUNWU_IMAGE_MODEL=gpt-image-1
YUNWU_IMAGE_TIMEOUT_SECONDS=180
# Used when IMAGE_PROVIDER is cloudflare or openai.
IMAGE_BASE_URL=https://api.cloudflare.com/client/v4
IMAGE_API_KEY=
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_ACCOUNT_ID=
IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_RETRIES=2

API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOW_ORIGINS=https://CHANGE_ME.ts.net
PUBLIC_APP_URL=https://CHANGE_ME.ts.net
PAPERFORGE_PUBLIC_APP_URL=https://CHANGE_ME.ts.net
PAPERFORGE_API_INTERNAL_BASE=http://api:8080
PAPERFORGE_WEB_PORT=3000
PAPERFORGE_SKIP_BUILD=false
NEXT_PUBLIC_DEMO_MODE=false

AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=30
AUTH_IDLE_DAYS=7
AUTH_RATE_LIMIT_ENABLED=true
AUTH_DEV_LOGIN_ENABLED=false
AUTH_EMAIL_MODE=smtp
AUTH_EMAIL_OUTBOX_DIR=/data/auth-outbox

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME@example.com
SMTP_USE_TLS=true
