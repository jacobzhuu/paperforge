%% PaperForge 生成的 LaTeX 工程（模板：article）
%% 导言区由模板锁定，LLM 不可修改（设计 §4.6）。
\documentclass[11pt,a4paper]{article}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}

%% natbib 必须与 plainnat/IEEEtran 这类「带标签的 .bst」成对出现。
%%
%% 少了它，plainnat 写进 .bbl 的 `\bibitem[Wang et al.(2023)Wang, Li, ...]{key}`
%% 会被 LaTeX 原样当成引用标签打印出来——正文里出现的是
%% `[Wang et al.(2023)Wang, Li, Zhang, and Chen]` 这样一整行、且不可断行的盒子，
%% 实测单个引用就有 124pt 的 Overfull hbox，直接溢出版心
%% （连 hyperref 的链接热区都跑到 MediaBox 之外）。
%% natbib 接管后同一条引用是 `(Wang et al., 2023)`。
%% natbib.sty 与 plainnat.bst 都已烤进 texd 镜像的 Tectonic 缓存（实测：断网、
%% 不挂缓存卷的 paperforge-texd:local 也能编出来），不需要重建 texd 镜像。
\usepackage[{{ natbib_options }}]{natbib}

\usepackage{hyperref}
\hypersetup{hidelinks}
\usepackage{xcolor}
\usepackage[margin=2.5cm]{geometry}
{% if language == 'zh' %}\usepackage{ctex}{% endif %}

%% 浮动体排版参数（核心 LaTeX，不引入任何宏包——texd 运行时无外网，
%% Tectonic 的包缓存只在镜像构建期预热，新增 \usepackage 会直接编译失败）。
%%
%% 默认值非常保守：一页最多 2 个顶部浮动体、正文至少要占 20%，稍微放不下
%% LaTeX 就把图推进延迟队列，队列只在 \clearpage / 文末冲刷——这正是
%% 「图片全堆在论文最后」的成因。下面把配额放宽到排版上仍然合理的范围。
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.7}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.75}

%% 渲染器只会发 `\cite{...}`（见 latex_render/renderer.py 的 CiteRun 分支）。
%% natbib 在作者-年份模式下把 `\cite` 解释为 `\citet`，排出来是
%% 「Wang et al. (2023) 指出……」的正文式引用；而 PaperForge 的引用一律挂在
%% 句末，需要的是括注式的 `\citep`。`\let` 是完全等价的别名（可选参数
%% `\cite[见][§3]{k}` 照常生效），比 `\renewcommand` 安全。
%% 放进 `\AtBeginDocument`：hyperref 会在导言区末尾给 natbib 的引用命令打补丁，
%% 早于它取别名会把补丁前的版本固定下来。
\AtBeginDocument{\let\cite\citep}

%% 未补充实验数据的显式占位（学术诚信红线：不编造数据）。
\providecommand{\todo}[1]{\textcolor{red}{\textbf{[TODO: #1]}}}

\title{ {{- title -}} }
{% if author_block %}\author{ {{- author_block -}} }{% else %}\author{}{% endif %}
\date{}

\begin{document}
\maketitle

{% if abstract %}\begin{abstract}
{{ abstract }}
\end{abstract}{% endif %}
{% if keywords %}

\noindent\textbf{ {{- keywords_label -}} } {{ keywords }}
{% endif %}

{{ body }}

\clearpage

{% if has_bibliography %}\bibliographystyle{ {{- bibstyle -}} }
\bibliography{refs}
{% endif %}
\end{document}
