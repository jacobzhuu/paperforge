%% PaperForge 生成的 LaTeX 工程（模板：IEEEtran）
%% 导言区由模板锁定，LLM 不可修改（设计 §4.6）。
\documentclass[conference]{IEEEtran}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{xcolor}
%% IEEE 模板**不需要** natbib——它下面的 `\bibliographystyle` 是写死的
%% `IEEEtran`，不走模板的 bibstyle 槽位（IEEE 投稿一律编号引用，这是格式要求，
%% 不随项目的 citation_style 变化）。IEEEtran.bst 产出的是无标签 `\bibitem`，
%% `cite` 宏包排出的就是 [1]、[2]--[4]，正确且是 IEEE 推荐组合。
%%
%% 反过来在这里加 natbib 会直接编译失败：实测 `ieeetran × author_year` 报
%% `Package natbib Error: Bibliography not compatible with author-year citations`
%% ——natbib 处于作者-年份模式，而 .bbl 里根本没有作者-年份元数据。
%% article 模板的情况不同：它确实按 citation_style 切换 .bst，所以必须配 natbib。
\usepackage{cite}
{% if language == 'zh' %}\usepackage{ctex}{% endif %}

%% 浮动体排版参数（核心 LaTeX，不引入任何宏包——texd 运行时无外网，
%% Tectonic 的包缓存只在镜像构建期预热，新增 \usepackage 会直接编译失败）。
%%
%% 默认值非常保守：一页最多 2 个顶部浮动体、正文至少要占 20%，稍微放不下
%% LaTeX 就把图推进延迟队列，队列只在 \clearpage / 文末冲刷——这正是
%% 「图片全堆在论文最后」的成因。下面把配额放宽到排版上仍然合理的范围。
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.7}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.75}

\providecommand{\todo}[1]{\textcolor{red}{\textbf{[TODO: #1]}}}

\begin{document}

\title{ {{- title -}} }
{% if author_block %}\author{ {{- author_block -}} }{% endif %}
\maketitle

{% if abstract %}\begin{abstract}
{{ abstract }}
\end{abstract}{% endif %}
{% if keywords %}\begin{IEEEkeywords}
{{ keywords }}
\end{IEEEkeywords}{% endif %}

{{ body }}

\clearpage

{% if has_bibliography %}\bibliographystyle{IEEEtran}
\bibliography{refs}
{% endif %}
\end{document}
