#!/usr/bin/env python3
"""Initialize private Langfuse configuration and manage the independent stack."""

import argparse
import os
import secrets
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("command", choices=["init", "up", "status"])
parser.add_argument("--network", default="paperforge-prod_core")
args = parser.parse_args()
config = ROOT / ".paperforge/langfuse.env"
if args.command in {"init", "up"} and not config.exists():
    config.parent.mkdir(parents=True, exist_ok=True)
    values = {
        name: secrets.token_hex(24)
        for name in (
            "LF_DB_PASSWORD",
            "LF_AUTH_SECRET",
            "LF_SALT",
            "LF_CLICKHOUSE_PASSWORD",
            "LF_REDIS_PASSWORD",
            "LF_S3_PASSWORD",
            "LF_ADMIN_PASSWORD",
        )
    }
    values.update(
        LF_ENCRYPTION_KEY=secrets.token_hex(32),
        LF_PUBLIC_KEY="pk-lf-" + secrets.token_hex(16),
        LF_SECRET_KEY="sk-lf-" + secrets.token_hex(32),
        LF_APPLICATION_NETWORK=args.network,
    )
    if not all(c.isalnum() or c in "_.-" for c in args.network):
        parser.error("invalid Docker network name")
    fd = os.open(config, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write("".join(f"{key}={value}\n" for key, value in values.items()))
if not config.exists():
    parser.error("run init first")
if config.stat().st_mode & 0o077:
    parser.error(f"private configuration permissions must be 600: {config}")
print(f"Private configuration: {config}; existing credentials are preserved.", flush=True)
if args.command != "init":
    command = [
        "docker",
        "compose",
        "-p",
        "paperforge-observability",
        "--env-file",
        str(config),
        "-f",
        str(ROOT / "infra/docker-compose.langfuse.yml"),
    ]
    command += ["up", "-d"] if args.command == "up" else ["ps"]
    subprocess.run(command, check=True)
