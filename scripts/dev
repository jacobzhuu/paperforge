#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT_DIR}/infra/docker-compose.yml"
BLUEGREEN_FILE="${ROOT_DIR}/infra/docker-compose.bluegreen.yml"
STATE_DIR="${ROOT_DIR}/.paperforge"
RUN_DIR="${STATE_DIR}/run"
LOG_DIR="${STATE_DIR}/logs"
DEPLOY_STATE="${STATE_DIR}/deploy.env"
PUBLIC_URL="${PAPERFORGE_PUBLIC_URL:-https://paperforge-linux.tail53ab99.ts.net}"
WEB_HOST_PORT="${PAPERFORGE_WEB_PORT:-3000}"
WEB_URL="${PAPERFORGE_WEB_URL:-http://localhost:${WEB_HOST_PORT}}"
API_URL="${PAPERFORGE_API_URL:-http://localhost:8080}"
WEB_MODE="${PAPERFORGE_WEB_MODE:-development}"
TEXD_URL="${PAPERFORGE_TEXD_URL:-http://localhost:8081}"
VISUALD_URL="${PAPERFORGE_VISUALD_URL:-http://localhost:8082}"
POSTGRES_HOST_PORT="${PAPERFORGE_POSTGRES_PORT:-15432}"
REDIS_HOST_PORT="${PAPERFORGE_REDIS_PORT:-16379}"
MINIO_API_HOST_PORT="${PAPERFORGE_MINIO_API_PORT:-19000}"
MINIO_CONSOLE_HOST_PORT="${PAPERFORGE_MINIO_CONSOLE_PORT:-19001}"
MINIO_API_URL="http://localhost:${MINIO_API_HOST_PORT}"
MINIO_CONSOLE_URL="http://localhost:${MINIO_CONSOLE_HOST_PORT}"

export POSTGRES_HOST_PORT REDIS_HOST_PORT MINIO_API_HOST_PORT MINIO_CONSOLE_HOST_PORT

COMPOSE=(docker compose --progress plain -f "${COMPOSE_FILE}")
PNPM_COMMAND=(pnpm)

usage() {
  cat <<'EOF'
Usage: ./scripts/dev <command>

Commands:
  up       Install locked dependencies and start every local service
  restart  Apply your code changes. Rolls the deployed stack when one is
           running (see below); otherwise stops and starts the local stack
           (`up` skips processes that are already running, so it will NOT
           pick up your edits)
  deploy   Force the deployed-stack roll, even with no deployment running
  reap     Inspect superseded blue/green deployments and report which ones
           have no queued or in-progress ARQ jobs. Pass --apply to remove
           only deployments that remain drained across two checks.
  down     Stop PaperForge services (persistent database volumes are kept)
  status   Show service status and local URLs
  logs     Show recent application and Docker service logs

Deployed-stack roll (`restart` when a paperforge-deploy-* project is up):
  rebuilds the api/worker/web images, starts a NEW deployment beside the old
  one, points Tailscale Funnel at it, and leaves the old one running. It has
  to work this way because Snap Docker on this host refuses to stop or
  recreate a running container. Add --local to force the local stack instead.
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

prepare_state() {
  mkdir -p "${RUN_DIR}" "${LOG_DIR}"
}

expected_process_marker() {
  case "$1" in
    api) echo "paperforge-api" ;;
    worker) echo "paperforge_worker.worker.WorkerSettings" ;;
    web) echo "pnpm" ;;
    *) return 1 ;;
  esac
}

managed_process_is_running() {
  local name="$1"
  local pid_file="${RUN_DIR}/${name}.pid"
  local pid=""
  local marker=""
  local command_line=""

  [ -s "${pid_file}" ] || return 1
  pid="$(tr -d '[:space:]' < "${pid_file}")"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "${pid}" >/dev/null 2>&1 || return 1
  marker="$(expected_process_marker "${name}")"
  command_line="$(ps -p "${pid}" -o command= 2>/dev/null || true)"
  [[ "${command_line}" == *"${marker}"* ]]
}

start_process() {
  local name="$1"
  local cwd="$2"
  shift 2
  local pid_file="${RUN_DIR}/${name}.pid"
  local log_file="${LOG_DIR}/${name}.log"
  local pid=""

  if managed_process_is_running "${name}"; then
    echo "✓ ${name} already running"
    return
  fi

  : > "${log_file}"
  (
    cd "${cwd}"
    nohup "$@" >> "${log_file}" 2>&1 < /dev/null &
    echo "$!" > "${pid_file}"
  )
  sleep 1
  pid="$(tr -d '[:space:]' < "${pid_file}")"
  if ! managed_process_is_running "${name}"; then
    echo "Failed to start ${name}; recent log:" >&2
    tail -n 40 "${log_file}" >&2 || true
    return 1
  fi
  echo "✓ ${name} started (pid ${pid})"
}

stop_process() {
  local name="$1"
  local pid_file="${RUN_DIR}/${name}.pid"
  local pid=""
  local attempt=0

  if ! managed_process_is_running "${name}"; then
    [ -e "${pid_file}" ] && : > "${pid_file}"
    return 0
  fi

  pid="$(tr -d '[:space:]' < "${pid_file}")"
  kill "${pid}"
  for attempt in $(seq 1 20); do
    if ! kill -0 "${pid}" >/dev/null 2>&1; then
      : > "${pid_file}"
      echo "✓ ${name} stopped"
      return
    fi
    sleep 0.25
  done
  kill -KILL "${pid}" >/dev/null 2>&1 || true
  : > "${pid_file}"
  echo "✓ ${name} force-stopped"
}

stop_host_processes() {
  stop_process web
  stop_process worker
  stop_process api
}

ensure_docker() {
  if docker info >/dev/null 2>&1; then
    return
  fi

  if [ "$(uname -s)" = "Darwin" ] && open -Ra Docker >/dev/null 2>&1; then
    echo "Docker Desktop is not running; starting it now..."
    open -ga Docker
    for _attempt in $(seq 1 90); do
      if docker info >/dev/null 2>&1; then
        echo "✓ Docker Desktop is ready"
        return
      fi
      sleep 2
    done
  fi

  if [ "$(uname -s)" = "Linux" ]; then
    echo "Docker daemon is unavailable. Start it with 'sudo systemctl start docker' and retry." >&2
  else
    echo "Docker daemon is unavailable. Start Docker Desktop and retry." >&2
  fi
  return 1
}

select_pnpm() {
  local installed_version=""
  if command -v pnpm >/dev/null 2>&1; then
    # Corepack 在仓库根（没有 packageManager 字段）会尝试下载“最新版”；
    # 必须从含有 packageManager=pnpm@9.15.9 的 Web 包目录探测。
    installed_version="$(cd "${ROOT_DIR}/apps/web" && pnpm --version 2>/dev/null || true)"
  fi
  if [ "${installed_version}" = "9.15.9" ]; then
    PNPM_COMMAND=(pnpm)
    return
  fi
  if command -v corepack >/dev/null 2>&1; then
    PNPM_COMMAND=(corepack pnpm)
    echo "Using Corepack with project-pinned pnpm 9.15.9 (installed: ${installed_version:-none})"
    return
  fi
  require_command npx
  PNPM_COMMAND=(npx -y pnpm@9.15.9)
  echo "Using project-pinned pnpm 9.15.9 (installed: ${installed_version:-none})"
}

select_local_web_port() {
  # 正式容器通常占用 3000。本地开发栈不能停它，也不能因为端口冲突启动失败；
  # 未显式指定端口时自动落到部署滚动端口段之外的 3100-3199。
  if [ -n "${PAPERFORGE_WEB_PORT:-}" ] || managed_process_is_running web; then
    return
  fi
  if port_is_free "${WEB_HOST_PORT}"; then
    return
  fi
  local candidate=""
  for candidate in $(seq 3100 3199); do
    if port_is_free "${candidate}"; then
      WEB_HOST_PORT="${candidate}"
      if [ -z "${PAPERFORGE_WEB_URL:-}" ]; then
        WEB_URL="http://localhost:${candidate}"
      fi
      echo "Port 3000 is already in use; local Web will use ${WEB_HOST_PORT}."
      return
    fi
  done
  echo "No free local Web port in 3100-3199" >&2
  return 1
}

wait_http() {
  local name="$1"
  local url="$2"
  local attempts="${3:-90}"
  local attempt=0

  for attempt in $(seq 1 "${attempts}"); do
    # --noproxy: 本地健康检查绝不走 HTTP(S)_PROXY，否则代理会把 127.0.0.1 请求变成 502。
    if curl -fsS --noproxy '*' --max-time 2 "${url}" >/dev/null 2>&1; then
      echo "✓ ${name} healthy (${url})"
      return
    fi
    sleep 1
  done
  echo "${name} did not become healthy: ${url}" >&2
  return 1
}

verify_public_deployment() {
  local local_url="$1" public_url="$2" expected_port="$3"
  local actual_port="" temp_dir="" local_body="" public_body="" local_hash="" public_hash=""

  actual_port="$(funnel_target_port || true)"
  if [ "${actual_port}" != "${expected_port}" ]; then
    echo "Funnel target mismatch: expected 127.0.0.1:${expected_port}, found 127.0.0.1:${actual_port:-unknown}" >&2
    return 1
  fi

  # 200 只能证明公网入口可访问，不能证明它已经是刚构建的版本。登录页不含用户数据，
  # 可以安全地与新容器直连响应逐字节比较；哈希一致才算公网切换完成。
  temp_dir="$(mktemp -d)"
  local_body="${temp_dir}/local.html"
  public_body="${temp_dir}/public.html"
  if ! curl -fsS --max-time 15 "${local_url}/login" -o "${local_body}" \
    || ! curl -fsS --max-time 30 "${public_url}/login" -o "${public_body}"; then
    rm -r "${temp_dir}"
    echo "Unable to download local/public login pages for deployment verification" >&2
    return 1
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    local_hash="$(sha256sum "${local_body}" | awk '{print $1}')"
    public_hash="$(sha256sum "${public_body}" | awk '{print $1}')"
  else
    # macOS 默认提供 shasum，开发脚本的部署流程也必须可用。
    local_hash="$(shasum -a 256 "${local_body}" | awk '{print $1}')"
    public_hash="$(shasum -a 256 "${public_body}" | awk '{print $1}')"
  fi
  rm -r "${temp_dir}"
  if [ "${local_hash}" != "${public_hash}" ]; then
    echo "Public deployment content mismatch: local ${local_hash}, public ${public_hash}" >&2
    return 1
  fi
  echo "✓ Funnel target and public content match the new deployment (${public_hash})"
}

verify_texd_runtime() {
  local project="$1"
  # 健康端点只证明 uvicorn 活着，不能证明离线 Tectonic 缓存含有模板依赖。
  # 2026-08-01 的真实事故就是 longtable 优化已进 worker，但部署复用了旧 texd，
  # 公网切换后所有长证据台账都在运行时尝试联网取包并失败。
  docker exec "${project}-worker-1" python -c '
import httpx

source = r"""\documentclass{article}
\usepackage{booktabs}
\usepackage{longtable}
\begin{document}
\begin{longtable}{ll}
\toprule A & B \\
\midrule 1 & 2 \\
\bottomrule
\end{longtable}
\end{document}
"""
response = httpx.post(
    "http://texd:8081/compile",
    json={"text_files": {"main.tex": source}, "binary_files": {}, "entrypoint": "main.tex"},
    timeout=90,
)
response.raise_for_status()
payload = response.json()
if not payload.get("ok") or not payload.get("pdf_base64"):
    print(str(payload.get("log") or "")[-2000:])
    raise SystemExit("texd runtime preflight failed")
print("✓ texd offline longtable preflight passed")
'
}

verify_object_store() {
  local project="$1"
  # 对象存储是蓝绿栈外部的共享服务，compose 门不住它。健康检查只证明桶还在，
  # 这里再走一次真实写—读—删：凭据失效或桶策略变成只读同样会让每条生成在
  # INGEST 崩掉，而那时 SEARCH/SCREEN 的钱已经花掉了。
  # 2026-08-03 起 MinIO 停了 11 天，中间照常滚了 5 次部署，没有一次发现。
  docker exec "${project}-worker-1" python -c '
import os

from paperforge_worker.config import get_settings
from paperforge_worker.healthcheck import enforce_deadline
from storage import make_object_store

settings = get_settings()
# 黑洞掉的端点会让 MinIO 客户端挂十几分钟；部署不能停在那里等。
enforce_deadline(30)
store = make_object_store(settings)
key = "healthcheck/deploy-preflight-%s" % os.urandom(8).hex()
payload = os.urandom(32)
store.put(key, payload)
try:
    if store.get(key) != payload:
        raise SystemExit("object store round trip returned different bytes")
finally:
    store.delete(key)
print("✓ object store round trip passed (%s)" % settings.storage_backend)
'
}

wait_postgres() {
  local attempt=0
  for attempt in $(seq 1 60); do
    if "${COMPOSE[@]}" exec -T postgres pg_isready -U paperforge >/dev/null 2>&1; then
      echo "✓ postgres healthy"
      return
    fi
    sleep 1
  done
  echo "postgres did not become healthy" >&2
  return 1
}

wait_redis() {
  local attempt=0
  for attempt in $(seq 1 60); do
    if [ "$("${COMPOSE[@]}" exec -T redis redis-cli ping 2>/dev/null || true)" = "PONG" ]; then
      echo "✓ redis healthy"
      return
    fi
    sleep 1
  done
  echo "redis did not become healthy" >&2
  return 1
}

show_recent_logs() {
  set +e
  echo
  echo "Recent Docker logs:"
  "${COMPOSE[@]}" logs --tail=40
  for name in api worker web; do
    if [ -f "${LOG_DIR}/${name}.log" ]; then
      echo
      echo "Recent ${name} log:"
      tail -n 40 "${LOG_DIR}/${name}.log"
    fi
  done
  set -e
}

up_failed() {
  local exit_code=$?
  trap - ERR
  echo
  echo "PaperForge startup failed; cleaning up started services." >&2
  show_recent_logs
  stop_host_processes
  "${COMPOSE[@]}" down >/dev/null 2>&1 || true
  exit "${exit_code}"
}

up() {
  trap up_failed ERR
  require_command docker
  require_command curl
  require_command uv
  prepare_state
  ensure_docker
  select_pnpm
  select_local_web_port

  if [ ! -f "${ROOT_DIR}/.env" ]; then
    cp "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
    echo "✓ created .env from .env.example"
  fi

  echo "Installing locked dependencies..."
  (
    cd "${ROOT_DIR}"
    uv sync --all-packages --frozen
  )
  (
    cd "${ROOT_DIR}/apps/web"
    CI=1 "${PNPM_COMMAND[@]}" install --frozen-lockfile
  )

  if [ "${WEB_MODE}" = "production" ]; then
    echo "Building production Web app..."
    (
      cd "${ROOT_DIR}/apps/web"
      PAPERFORGE_API_INTERNAL_BASE="http://127.0.0.1:8080" \
        NEXT_PUBLIC_DEMO_MODE=false \
        "${PNPM_COMMAND[@]}" build
    )
  elif [ "${WEB_MODE}" != "development" ]; then
    echo "Unsupported PAPERFORGE_WEB_MODE: ${WEB_MODE}" >&2
    return 1
  fi

  echo "Starting Docker services..."
  # `up` is idempotent and intentionally does not reload code. Compose will build a
  # missing local image on first use; forcing a rebuild here makes every ordinary
  # startup redownload fonts/TeX packages. Use `restart --local` after code changes.
  "${COMPOSE[@]}" up -d

  # Host services must never start against an older schema: the API can otherwise boot and
  # fail only when a newly added endpoint first touches its table (for example account signup).
  wait_postgres
  echo "Applying database migrations..."
  (
    cd "${ROOT_DIR}"
    DATABASE_URL="postgresql+asyncpg://paperforge:paperforge@localhost:${POSTGRES_HOST_PORT}/paperforge" \
      uv run alembic upgrade head
  )

  start_process api "${ROOT_DIR}" \
    env \
      API_HOST=127.0.0.1 \
      API_PORT=8080 \
      CORS_ALLOW_ORIGINS="${WEB_URL}" \
      PUBLIC_APP_URL="${WEB_URL}" \
      DATABASE_URL="postgresql+asyncpg://paperforge:paperforge@localhost:${POSTGRES_HOST_PORT}/paperforge" \
      REDIS_URL="redis://localhost:${REDIS_HOST_PORT}/0" \
      MINIO_ENDPOINT="localhost:${MINIO_API_HOST_PORT}" \
      VISUALD_URL="${VISUALD_URL}" \
      uv run paperforge-api
  start_process worker "${ROOT_DIR}" \
    env REDIS_URL="redis://localhost:${REDIS_HOST_PORT}/0" VISUALD_URL="${VISUALD_URL}" \
      uv run arq paperforge_worker.worker.WorkerSettings
  if [ "${WEB_MODE}" = "production" ]; then
    start_process web "${ROOT_DIR}/apps/web" \
      env \
        NODE_ENV=production \
        PAPERFORGE_API_INTERNAL_BASE="http://127.0.0.1:8080" \
        NEXT_PUBLIC_DEMO_MODE=false \
        "${PNPM_COMMAND[@]}" start --hostname 127.0.0.1 --port "${WEB_HOST_PORT}"
  else
    start_process web "${ROOT_DIR}/apps/web" \
      "${PNPM_COMMAND[@]}" dev --hostname 127.0.0.1 --port "${WEB_HOST_PORT}"
  fi

  echo "Waiting for health checks..."
  wait_redis
  wait_http minio "${MINIO_API_URL}/minio/health/live"
  wait_http texd "${TEXD_URL}/healthz"
  wait_http visuald "${VISUALD_URL}/healthz"
  wait_http api "${API_URL}/healthz"
  wait_http web "${WEB_URL}"
  managed_process_is_running worker

  trap - ERR
  echo
  echo "PaperForge is ready."
  echo "Web:     ${WEB_URL}"
  echo "API:     ${API_URL}"
  echo "Metrics: ${API_URL}/metrics"
  echo "MinIO:   ${MINIO_CONSOLE_URL}"
  echo "Visuals: ${VISUALD_URL}"
  echo
  echo "Stop everything with: ./scripts/dev down"
  echo "Inspect status with:   ./scripts/dev status"

  if [ "${PAPERFORGE_OPEN_BROWSER:-1}" != "0" ] && [ "$(uname -s)" = "Darwin" ]; then
    open "${WEB_URL}"
  fi
}

# ---------------------------------------------------------------------------
# 部署态滚动。
#
# 这台机器使用 Snap Docker；历史上 docker-default 缺少 snap.docker.dockerd 的
# signal/ptrace 规则。即使主机已加载 scripts/docker-default-snap.apparmor，生产
# 更新仍保持蓝绿滚动：先起新版本并切换 Funnel，确认健康后再单独清理旧版本。
# ---------------------------------------------------------------------------

deploy_env_file() {
  # 生产 env 文件不在仓库里（scripts/ops 也强制这一点）。优先用显式变量，
  # 其次从在跑的部署上把它读回来——这样重启一次之后就不用再手工传了。
  local project="" value=""
  if [ -n "${PAPERFORGE_ENV_FILE:-}" ]; then
    echo "${PAPERFORGE_ENV_FILE}"
    return
  fi
  project="$(detect_deploy_project || true)"
  if [ -n "${project}" ]; then
    value="$(docker inspect -f \
      '{{index .Config.Labels "com.docker.compose.project.environment_file"}}' \
      "${project}-api-1" 2>/dev/null || true)"
    # compose 记的是逗号分隔的列表；只取第一个。
    value="${value%%,*}"
    if [ -n "${value}" ] && [ -f "${value}" ]; then
      echo "${value}"
      return
    fi
  fi
  if [ -f "${DEPLOY_STATE}" ]; then
    # shellcheck disable=SC1090
    value="$(. "${DEPLOY_STATE}" && echo "${PAPERFORGE_ENV_FILE:-}")"
    if [ -n "${value}" ] && [ -f "${value}" ]; then
      echo "${value}"
      return
    fi
  fi
  return 1
}

detect_deploy_project() {
  # 当前在跑的蓝绿项目；同名前缀可能有多个（旧的停不掉），取最新创建的那个。
  docker ps \
    --filter 'label=com.docker.compose.project' \
    --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null \
    | grep '^paperforge-deploy-' \
    | head -n 1
}

tailscale_socket() {
  # tailscaled 以 userspace 模式跑在用户态，socket 不在默认路径上。
  local socket=""
  # Filter by executable name first: matching the whole command line also matches
  # this discovery command (or its parent shell) and can return the regex itself.
  socket="$(ps -eo comm=,args= 2>/dev/null \
    | awk '$1 ~ /(^|\/)tailscaled$/ {
        for (i = 3; i <= NF; i++) {
          if ($i ~ /^--socket=/) { sub(/^--socket=/, "", $i); print $i; exit }
          if ($i == "--socket" && i < NF) { print $(i + 1); exit }
        }
      }')"
  echo "${socket:-/var/run/tailscale/tailscaled.sock}"
}

tailscale_cli() {
  command -v tailscale >/dev/null 2>&1 || return 1
  tailscale --socket="$(tailscale_socket)" "$@"
}

funnel_target_port() {
  tailscale_cli funnel status 2>/dev/null \
    | sed -n 's|.*proxy http://127.0.0.1:\([0-9]\{1,\}\).*|\1|p' | head -n 1
}

deployment_for_web_port() {
  local wanted_port="$1" container binding project
  [ -n "${wanted_port}" ] || return 1
  for container in $(docker ps -q \
    --filter 'label=com.docker.compose.project' \
    --filter 'label=com.docker.compose.service=web' 2>/dev/null); do
    binding="$(docker port "${container}" 3000/tcp 2>/dev/null \
      | sed -n 's|.*:\([0-9][0-9]*\)$|\1|p' | head -n 1)"
    [ "${binding}" = "${wanted_port}" ] || continue
    project="$(docker inspect -f \
      '{{index .Config.Labels "com.docker.compose.project"}}' "${container}")"
    case "${project}" in paperforge-deploy-*) echo "${project}"; return 0 ;; esac
  done
  return 1
}

deployment_drain_state() {
  # Print "queued in_progress" for one deployment-specific Redis database.  Run the
  # check inside that deployment's worker so host networking and Redis credentials do
  # not need to be copied or exposed.  Any inspection failure is a hard "do not reap".
  local project="$1" workers worker_count
  workers="$(docker ps -q \
    --filter "label=com.docker.compose.project=${project}" \
    --filter 'label=com.docker.compose.service=worker' 2>/dev/null)"
  worker_count="$(wc -w <<<"${workers}" | tr -d '[:space:]')"
  [ "${worker_count}" -ge "1" ] || return 1
  workers="$(head -n 1 <<<"${workers}")"
  docker exec "${workers}" python -c '
import asyncio
import os

from arq import create_pool
from arq.connections import RedisSettings


async def active_progress(redis, keys):
    from arq.constants import keep_cronjob_progress

    active = 0
    for key in keys:
        job_id = key.decode().removeprefix("arq:in-progress:")
        if job_id.startswith(("cron:shadow_tick:", "cron:citation_shadow_tick:")):
            # ARQ atomically deletes the job and shortens this marker on completion.
            # The remaining marker prevents duplicate cron scheduling; it is not work.
            async with redis.pipeline(transaction=True) as pipe:
                pipe.exists("arq:job:" + job_id)
                pipe.pttl(key)
                exists, ttl = await pipe.execute()
            if not exists and 0 < ttl <= keep_cronjob_progress * 1000:
                continue
        active += 1
    return active


async def check():
    redis = await create_pool(RedisSettings.from_dsn(os.environ["REDIS_URL"]))
    try:
        queued = int(await redis.zcard(redis.default_queue_name))
        queued += int(await redis.zcard("arq:short"))
        cursor = 0
        in_progress = 0
        while True:
            cursor, keys = await redis.scan(
                cursor=cursor,
                match="arq:in-progress:*",
                count=100,
            )
            in_progress += await active_progress(redis, keys)
            if cursor == 0:
                break
        # Pending PostgreSQL intents also own work, even before Redis enqueue.
        import hashlib
        from sqlalchemy import text
        from sqlalchemy.ext.asyncio import create_async_engine
        engine = create_async_engine(os.environ["DATABASE_URL"])
        try:
            async with engine.connect() as connection:
                exists = await connection.scalar(text("SELECT to_regclass(:name)"), {"name": "job_dispatch"})
                if exists:
                    pending = await connection.scalar(text(
                        "SELECT count(*) FROM job_dispatch d JOIN generation_job j ON j.id=d.job_id "
                        "WHERE d.queue_identity=:identity AND "
                        "(j.status IN (:queued,:running) OR d.lease_until > now())"
                    ), {"identity": hashlib.sha256(os.environ["REDIS_URL"].encode()).hexdigest(),
                        "queued": "queued", "running": "running"})
                    queued += pending
        finally:
            await engine.dispose()
        print(f"{queued} {in_progress}")
    finally:
        await redis.aclose()


asyncio.run(check())
'
}

reap_deployments() {
  local mode="${1:---dry-run}" state_project="" funnel_project="" funnel_port=""
  local protected=" " projects project state queued in_progress confirmed containers remaining
  case "${mode}" in
    --dry-run|'') mode="--dry-run" ;;
    --apply) ;;
    *) echo "Usage: ./scripts/dev reap [--dry-run|--apply]" >&2; return 1 ;;
  esac
  ensure_docker
  prepare_state

  if [ -f "${DEPLOY_STATE}" ]; then
    # shellcheck disable=SC1090
    state_project="$(. "${DEPLOY_STATE}" && echo "${PAPERFORGE_DEPLOY_PROJECT:-}")"
  fi
  funnel_port="$(funnel_target_port || true)"
  funnel_project="$(deployment_for_web_port "${funnel_port}" || true)"
  for project in "${state_project}" "${funnel_project}"; do
    [ -n "${project}" ] && protected="${protected}${project} "
  done
  if [ "${mode}" = "--apply" ] && [ -z "${funnel_project}" ]; then
    echo "Cannot identify the deployment serving the Funnel; refusing to remove anything." >&2
    return 1
  fi

  projects="$(docker ps \
    --filter 'label=com.docker.compose.project' \
    --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null \
    | grep '^paperforge-deploy-' | sort -u || true)"
  [ -n "${projects}" ] || { echo "No running blue/green deployments found."; return 0; }
  echo "Protected live deployment(s):${protected}"

  while IFS= read -r project; do
    [ -n "${project}" ] || continue
    case "${protected}" in
      *" ${project} "*) echo "KEEP  ${project} (live)"; continue ;;
    esac
    if ! state="$(deployment_drain_state "${project}" 2>/dev/null)"; then
      echo "KEEP  ${project} (worker/Redis state could not be verified)"
      continue
    fi
    read -r queued in_progress <<EOF
${state}
EOF
    if ! [[ "${queued}" =~ ^[0-9]+$ && "${in_progress}" =~ ^[0-9]+$ ]]; then
      echo "KEEP  ${project} (unexpected drain-state response)"
      continue
    fi
    if [ "${queued}" -ne 0 ] || [ "${in_progress}" -ne 0 ]; then
      echo "KEEP  ${project} (queued=${queued}, in_progress=${in_progress})"
      continue
    fi
    if [ "${mode}" = "--dry-run" ]; then
      echo "READY ${project} (drained; --apply would remove its containers, networks, and caches)"
      continue
    fi

    # Close the enqueue/start race without touching the candidate.  A superseded API has no
    # Funnel traffic, but two independent observations make that assumption verifiable.
    sleep 2
    if ! confirmed="$(deployment_drain_state "${project}" 2>/dev/null)" \
      || [ "${confirmed}" != "0 0" ]; then
      echo "KEEP  ${project} (became active or could not be reverified: ${confirmed:-unknown})"
      continue
    fi
    containers="$(docker ps -aq \
      --filter "label=com.docker.compose.project=${project}" 2>/dev/null)"
    if [ -n "${containers}" ] && ! docker rm -f ${containers} >/dev/null; then
      echo "KEEP  ${project} (Docker refused container removal)" >&2
      continue
    fi
    remaining="$(docker ps -aq \
      --filter "label=com.docker.compose.project=${project}" 2>/dev/null)"
    if [ -n "${remaining}" ]; then
      echo "KEEP  ${project} (container removal was incomplete)" >&2
      continue
    fi
    docker network rm "${project}_runtime" "${project}_ingress" >/dev/null 2>&1 || true
    # Blue/green volumes contain only reconstructible Tectonic/font caches. User data lives in
    # the external PostgreSQL/MinIO stack and is never targeted by this command.
    docker volume rm "${project}_texdcache" "${project}_texdfontcache" \
      >/dev/null 2>&1 || true
    echo "REAPED ${project} (drained twice; application images retained for recovery)"
  done <<EOF
${projects}
EOF
}

port_is_free() {
  ! ss -ltn 2>/dev/null | grep -q ":$1[[:space:]]"
}

free_web_port() {
  local port
  for port in $(seq 3004 3099); do
    if port_is_free "${port}"; then
      echo "${port}"
      return
    fi
  done
  echo "No free port in 3004-3099 for the new deployment" >&2
  return 1
}

current_image_of() {
  # 在跑的那套用的是哪个镜像。texd / visuald 不随应用代码变化，沿用它们即可；
  # 写死 :local 会把别人单独修过的渲染服务悄悄退回旧版本。
  local project="$1" service="$2" fallback="$3" image=""
  if [ -n "${project}" ]; then
    image="$(docker inspect -f '{{.Config.Image}}' "${project}-${service}-1" 2>/dev/null || true)"
  fi
  echo "${image:-${fallback}}"
}

previous_deploy_redis_url() {
  local value=""
  if [ -n "${PAPERFORGE_DEPLOY_REDIS_URL:-}" ]; then
    echo "${PAPERFORGE_DEPLOY_REDIS_URL}"
    return
  fi
  if [ -f "${DEPLOY_STATE}" ]; then
    # shellcheck disable=SC1090
    value="$(. "${DEPLOY_STATE}" && echo "${PAPERFORGE_DEPLOY_REDIS_URL:-}")"
  fi
  [ -n "${value}" ] && echo "${value}"
}

next_redis_url() {
  # 旧 worker 停不掉，会一直从原来的库号取任务；同库就等于把一半的生成任务
  # 交给旧镜像。换一个还没有 worker 在盯着的库号，新 API 入队的任务就只有
  # 新 worker 会消费。
  #
  # 「+1」不够：滚动多次之后库号会绕回来。按 Redis 主机分别统计实际占用，
  # 并自动沿用 deploy.env 里上一次切换到的专用 Redis；否则共享库 0-15 用满后，
  # 后续每次发布都必须手工重新 export PAPERFORGE_DEPLOY_REDIS_URL。
  local taken="" container db index worker_url worker_base seed_url redis_base
  seed_url="$(previous_deploy_redis_url || true)"
  if [ -n "${seed_url}" ]; then
    redis_base="$(sed -E 's|/[0-9]+$||' <<<"${seed_url}")"
  else
    redis_base="redis://redis:6379"
  fi
  for container in $(docker ps --format '{{.Names}}' 2>/dev/null | grep -- '-worker-1$'); do
    worker_url="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "${container}" 2>/dev/null \
      | sed -n 's|^REDIS_URL=||p' | head -n 1)"
    worker_base="$(sed -E 's|/[0-9]+$||' <<<"${worker_url}")"
    if [ "${worker_base}" = "${redis_base}" ]; then
      db="$(sed -n 's|.*/\([0-9]\{1,\}\)$|\1|p' <<<"${worker_url}" | head -n 1)"
      taken="${taken} ${db:-0}"
    fi
  done
  for index in $(seq 0 15); do
    case " ${taken} " in
      *" ${index} "*) ;;
      *) echo "${redis_base}/${index}"; return ;;
    esac
  done
  echo "All 16 Redis databases on ${redis_base} are taken by running workers; clean up old deployments or provide a new dedicated Redis" >&2
  return 1
}

next_deploy_subnets() {
  # Do not depend on Docker's implicit pools: blue/green history may retain
  # every one of them when the constrained daemon cannot remove old stacks.
  # Pick adjacent /24 networks from a dedicated range after checking all
  # existing Docker IPAM allocations and host routes.
  local used="" third runtime ingress
  used="$(docker network ls -q 2>/dev/null | xargs -r docker network inspect \
    --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}' 2>/dev/null || true)"
  for third in $(seq 0 253); do
    runtime="10.254.${third}.0/24"
    ingress="10.254.$((third + 1)).0/24"
    if ! grep -Fqx "${runtime}" <<<"${used}" \
      && ! grep -Fqx "${ingress}" <<<"${used}" \
      && ! ip route | grep -Eq "^10\\.254\\.${third}\\.0/24 |^10\\.254\\.$((third + 1))\\.0/24 "; then
      printf '%s %s\n' "${runtime}" "${ingress}"
      return
    fi
  done
  echo "No free explicit deployment subnets in 10.254.0.0/16" >&2
  return 1
}

verify_capacity_headroom() {
  local project="$1"
  [ -n "${project}" ] || return 0
  docker exec "${project}-worker-1" python -c '
import asyncio
from sqlalchemy import text
from sqlalchemy.ext.asyncio import create_async_engine
from paperforge_worker.config import get_settings

async def check():
    engine = create_async_engine(get_settings().database_url)
    try:
        async with engine.connect() as connection:
            maximum = int(await connection.scalar(text("SHOW max_connections")))
            used = int(await connection.scalar(text("SELECT count(*) FROM pg_stat_activity")))
            active = int(await connection.scalar(text(
                "SELECT count(*) FROM generation_job WHERE status=:status"), {"status": "running"}))
        # New stack: 2 API * 6 + 3 worker * 8 = 36. Reserve maintenance
        # connections and conservative overflow for still-running legacy jobs.
        required = used + 36 + 10 + min(active, 10) * 12
        print(f"PostgreSQL budget: current={used}, new=36, reserve=10, legacy_jobs={active}, max={maximum}")
        if required > maximum:
            raise SystemExit("insufficient PostgreSQL headroom; retain old jobs and defer deployment")
    finally:
        await engine.dispose()
asyncio.run(check())
'
}

build_deploy_images() {
  local tag="$1"
  echo "Building images (${tag})..."
  docker build --progress plain -f "${ROOT_DIR}/services/edge.Dockerfile" --target gateway \
    -t "paperforge-gateway:${tag}" "${ROOT_DIR}"
  docker build --progress plain -f "${ROOT_DIR}/services/edge.Dockerfile" --target monitoring \
    -t "paperforge-monitoring:${tag}" "${ROOT_DIR}"
  # texd 不是静态基础设施：模板新增宏包时，离线 Tectonic 缓存必须随部署更新。
  # Docker 的分层缓存会让未变化的 texd 构建快速命中；显式镜像覆盖仍可跳过构建。
  if [ -z "${PAPERFORGE_DEPLOY_TEXD_IMAGE:-}" ]; then
    docker build --network host --progress plain -f "${ROOT_DIR}/services/texd/Dockerfile" \
      -t "paperforge-texd:${tag}" "${ROOT_DIR}"
  fi
  if [ -z "${PAPERFORGE_DEPLOY_VISUALD_IMAGE:-}" ]; then
    docker build --network host --progress plain -f "${ROOT_DIR}/services/visuald/Dockerfile" \
      -t "paperforge-visuald:${tag}" "${ROOT_DIR}"
  fi
  docker build --network host --progress plain -f "${ROOT_DIR}/services/Dockerfile" --target api \
    -t "paperforge-api:${tag}" "${ROOT_DIR}"
  docker build --network host --progress plain -f "${ROOT_DIR}/services/Dockerfile" --target worker \
    -t "paperforge-worker:${tag}" "${ROOT_DIR}"
  docker build --network host --progress plain -f "${ROOT_DIR}/apps/web/Dockerfile" \
    -t "paperforge-web:${tag}" "${ROOT_DIR}"
}

deploy() {
  require_command docker
  require_command curl
  ensure_docker
  prepare_state

  local env_file previous tag port redis_db redis_url compose_project texd_image visuald_image subnets runtime_subnet runtime_network runtime_gateway ingress_subnet
  if ! env_file="$(deploy_env_file)"; then
    echo "No production env file. Set PAPERFORGE_ENV_FILE=/absolute/path/to/paperforge.env" >&2
    return 1
  fi
  previous="$(detect_deploy_project || true)"
  verify_capacity_headroom "${previous}"
  tag="deploy-$(date '+%Y%m%d-%H%M%S')"
  port="$(free_web_port)"
  redis_url="$(next_redis_url)"
  redis_db="$(sed -n 's|.*/\([0-9]\{1,\}\)$|\1|p' <<<"${redis_url}" | head -n 1)"
  subnets="$(next_deploy_subnets)"
  runtime_subnet="${subnets%% *}"
  runtime_network="${runtime_subnet%/*}"
  runtime_gateway="${runtime_network%.*}.1"
  ingress_subnet="${subnets##* }"
  compose_project="paperforge-${tag}"
  texd_image="${PAPERFORGE_DEPLOY_TEXD_IMAGE:-paperforge-texd:${tag}}"
  visuald_image="${PAPERFORGE_DEPLOY_VISUALD_IMAGE:-paperforge-visuald:${tag}}"

  echo "Rolling deployment"
  echo "  previous:  ${previous:-none}"
  echo "  project:   ${compose_project}"
  echo "  web port:  ${port}"
  echo "  redis db:  ${redis_db}"
  echo "  networks:  ${runtime_subnet}, ${ingress_subnet}"
  echo "  proxy:     ${runtime_gateway}:38888 → 127.0.0.1:${PAPERFORGE_HOST_PROXY_PORT:-38888}"
  echo "  texd:      ${texd_image}"
  echo "  visuald:   ${visuald_image}"

  build_deploy_images "${tag}"

  echo "Starting ${compose_project}..."
  PAPERFORGE_ENV_FILE="${env_file}" \
  PAPERFORGE_DEPLOY_PROJECT="${compose_project}" \
  PAPERFORGE_DEPLOY_API_IMAGE="paperforge-api:${tag}" \
  PAPERFORGE_DEPLOY_WORKER_IMAGE="paperforge-worker:${tag}" \
  PAPERFORGE_DEPLOY_WEB_IMAGE="paperforge-web:${tag}" \
  PAPERFORGE_DEPLOY_GATEWAY_IMAGE="paperforge-gateway:${tag}" \
  PAPERFORGE_DEPLOY_MONITORING_IMAGE="paperforge-monitoring:${tag}" \
  PAPERFORGE_DEPLOY_TEXD_IMAGE="${texd_image}" \
  PAPERFORGE_DEPLOY_VISUALD_IMAGE="${visuald_image}" \
  PAPERFORGE_DEPLOY_WEB_PORT="${port}" \
  PAPERFORGE_DEPLOY_REDIS_DB="${redis_db}" \
  PAPERFORGE_DEPLOY_REDIS_URL="${redis_url}" \
  PAPERFORGE_DEPLOY_RUNTIME_SUBNET="${runtime_subnet}" \
  PAPERFORGE_DEPLOY_RUNTIME_GATEWAY="${runtime_gateway}" \
  PAPERFORGE_DEPLOY_INGRESS_SUBNET="${ingress_subnet}" \
  PAPERFORGE_PUBLIC_URL="${PUBLIC_URL}" \
    docker compose --progress plain --env-file "${env_file}" \
      -f "${BLUEGREEN_FILE}" -f "${ROOT_DIR}/infra/docker-compose.monitoring.yml" \
      --profile worker up -d --wait --remove-orphans

  wait_http "new deployment" "http://127.0.0.1:${port}/login"
  verify_texd_runtime "${compose_project}"
  if ! verify_object_store "${compose_project}"; then
    echo "Object storage is unusable from the new worker; refusing to switch Funnel." >&2
    return 1
  fi

  # The public UI must not be switched to a worker that still cannot reach the
  # image provider.  Any HTTP response proves DNS/TLS/proxy connectivity; only
  # transport failures should abort the rollout.
  if ! docker exec "${compose_project}-worker-1" python -c \
    "import httpx; response=httpx.get('https://yunwu.ai', timeout=20); print(f'✓ image provider route reachable (HTTP {response.status_code})')"; then
    echo "Image provider route is unavailable from the new worker; refusing to switch Funnel." >&2
    return 1
  fi

  # Funnel 只是一条转发规则，改指向不需要重启 tailscaled。新容器必须换端口
  # （旧的占着且停不掉），所以这一步不能省，否则公网地址还连着旧代码。
  if tailscale_cli status >/dev/null 2>&1; then
    echo "Pointing Tailscale Funnel at 127.0.0.1:${port}..."
    tailscale_cli funnel --bg "${port}" >/dev/null
    wait_http "public URL" "${PUBLIC_URL}/login" 30
    verify_public_deployment "http://127.0.0.1:${port}" "${PUBLIC_URL}" "${port}"
  else
    echo "Tailscale is unavailable; refusing to mark this deployment live. Funnel still points at $(funnel_target_port || echo unknown)." >&2
    return 1
  fi

  {
    printf 'PAPERFORGE_ENV_FILE=%s\n' "${env_file}"
    printf 'PAPERFORGE_DEPLOY_PROJECT=%s\n' "${compose_project}"
    printf 'PAPERFORGE_DEPLOY_WEB_PORT=%s\n' "${port}"
    printf 'PAPERFORGE_DEPLOY_REDIS_DB=%s\n' "${redis_db}"
    printf 'PAPERFORGE_DEPLOY_REDIS_URL=%s\n' "${redis_url}"
    printf 'PAPERFORGE_DEPLOY_RUNTIME_SUBNET=%s\n' "${runtime_subnet}"
    printf 'PAPERFORGE_DEPLOY_RUNTIME_GATEWAY=%s\n' "${runtime_gateway}"
    printf 'PAPERFORGE_DEPLOY_INGRESS_SUBNET=%s\n' "${ingress_subnet}"
    printf 'PAPERFORGE_DEPLOY_TAG=%s\n' "${tag}"
  } >"${DEPLOY_STATE}"

  echo
  echo "Deployment is live: ${PUBLIC_URL} (local ${port})"
  if [ -n "${previous}" ]; then
    echo
    echo "The previous deployment (${previous}) remains available for in-flight jobs."
    echo "After it drains, inspect and safely remove superseded deployments with:"
    echo "  ./scripts/dev reap          # read-only"
    echo "  ./scripts/dev reap --apply  # verifies twice before removal"
  fi
}

restart() {
  local mode="${1:-auto}"
  if [ "${mode}" = "--local" ]; then
    echo "Restarting the local stack..."
    down
    up
    return
  fi
  if [ "${mode}" = "auto" ] && [ -z "$(detect_deploy_project || true)" ] && [ ! -f "${DEPLOY_STATE}" ]; then
    # 没有部署在跑，restart 就还是本地栈的含义：up() 对已在运行的进程直接跳过，
    # 不会加载新代码，所以必须先 down。
    echo "No deployment detected; restarting the local stack..."
    down
    up
    return
  fi
  deploy
}

down() {
  prepare_state
  stop_host_processes
  if docker info >/dev/null 2>&1; then
    "${COMPOSE[@]}" down
  else
    echo "Docker daemon is unavailable; host services were stopped." >&2
  fi
}

status() {
  prepare_state
  local project funnel_port
  project="$(detect_deploy_project || true)"
  if [ -n "${project}" ]; then
    echo "Deployment: ${project}"
    funnel_port="$(funnel_target_port || true)"
    echo "Funnel:     ${PUBLIC_URL} → 127.0.0.1:${funnel_port:-unknown}"
    # 共享的 PostgreSQL/Redis/MinIO 不属于这个 compose project，`ps` 看不到它们停了。
    local dependencies
    if dependencies="$(docker exec "${project}-worker-1" python -m paperforge_worker.healthcheck 2>&1)"; then
      echo "✓ shared dependencies: queue and object store reachable"
    elif [ "${dependencies#*No module named}" != "${dependencies}" ]; then
      echo "· shared dependencies: not checked (this deployment predates the probe)"
    else
      echo "✗ shared dependencies unavailable; generations will fail at INGEST:" >&2
      echo "  ${dependencies}" >&2
    fi
    docker compose -p "${project}" ps 2>/dev/null || true
    echo
  fi
  for name in api worker web; do
    if managed_process_is_running "${name}"; then
      echo "✓ local ${name}: running"
    else
      echo "✗ local ${name}: stopped"
    fi
  done
  if docker info >/dev/null 2>&1; then
    "${COMPOSE[@]}" ps
  else
    echo "✗ docker: unavailable"
  fi
  echo
  echo "Web: ${WEB_URL}"
  echo "API: ${API_URL}"
}

logs() {
  prepare_state
  show_recent_logs
}

case "${1:-}" in
  up) up ;;
  restart) restart "${2:-auto}" ;;
  deploy) deploy ;;
  reap) reap_deployments "${2:---dry-run}" ;;
  down) down ;;
  status) status ;;
  logs) logs ;;
  *) usage; exit 1 ;;
esac
