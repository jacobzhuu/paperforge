# Safe local-development defaults. Do not put production credentials in this file.

DATABASE_URL=postgresql+asyncpg://paperforge:paperforge@localhost:15432/paperforge
REDIS_URL=redis://localhost:16379/0

STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=paperforge
MINIO_SECRET_KEY=paperforge-secret
MINIO_BUCKET=paperforge
MINIO_SECURE=false

LLM_DEFAULT_PROVIDER=noop
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_ROLE_MODELS={"planner":"gpt-4o-mini","extractor":"gpt-4o-mini","reranker":"gpt-4o-mini","writer":"gpt-4o","polisher":"gpt-4o","verifier":"gpt-4o-mini"}
LLM_ROLE_THINKING={"extractor":"disabled","reranker":"disabled","verifier":"disabled"}
# Model -> price, in currency per MILLION tokens (the unit providers quote), so the
# numbers here are copied from a price page without conversion. Leave it empty and
# every call is recorded as UNPRICED: the cost panel then says the amount is a lower
# bound instead of showing a reassuring $0.00. Check what is missing with
# `paperforge-admin cost` — it lists every unpriced model by name.
#   LLM_MODEL_PRICES={"glm-5.3-flash":{"input":0.8,"output":2.8}}
LLM_MODEL_PRICES={}
# Currency LLM_MODEL_PRICES is quoted in. It only picks the symbol the cost panel
# and `paperforge-admin cost` print — nothing is converted. Set it to match the
# price page you copied from (a Zhipu CNY price rendered with a `$` is a lie the
# panel has no way to catch). Known: USD -> $, CNY -> ¥; anything else prints the
# code itself.
LLM_PRICE_CURRENCY=USD
# Per-role response to `output_truncated`. Empty uses the built-in policy, which
# only retries when raising the budget would actually clear the model's own
# ceiling by a meaningful margin — a retry that gains 2% of budget costs a whole
# extra call and returns the same truncated result.
#   LLM_ROLE_RETRY={"writer":{"max_attempts":0},"verifier":{"multiplier":2.0}}
LLM_ROLE_RETRY={}
# Per-attempt HTTP timeout (connect/read/write) for one LLM call, in seconds. This is
# the ceiling long calls actually hit: measured 2026-09-07, a writer asking for a
# 16k-token section averages 52.5s against this 60s default, and the calls that cross
# it burn timeout x (max_retries + 1) + backoff before failing. Raise it for a
# deployment whose writer legitimately needs longer; the cost is that a genuinely
# hung endpoint is waited on proportionally longer. Configure worker and API alike.
LLM_TIMEOUT_SECONDS=60
# Rewrite/re-evaluate rounds after the draft is written. 2 is the design value: one
# round walks one repair path, and two let the common "add evidence, then withdraw
# the claim" pair complete. This is the single largest block of wall clock in a full
# run (measured 2026-09-06: 37 of 66 minutes, 29 section rewrites), so a deployment
# in a hurry can drop it to 1 — that explicitly gives up the paired path, it is not
# a free speedup. 0 delivers the draft with no repair at all.
QUALITY_REPAIR_ROUNDS=2
CARD_CONCURRENCY=6
QMATRIX_CONCURRENCY=4

# LLM structured experiment extraction (P0-3). Default off: behaviour is then
# byte-identical to the deterministic regex pipeline.
#   shadow — extract and persist experiment_v3_llm rows for measurement, but keep
#            EvidenceMeasurement (and therefore comparability, synthesis and prose)
#            on the regex path only.
#   on     — reconciled dimensions feed EvidenceMeasurement, so comparability_key
#            finally groups results across papers.
# Promote to `on` only after shadow shows locator-verified >= 80%.
EXPERIMENT_EXTRACTION_MODE=off
EXPERIMENT_EXTRACTION_MAX_WORKS=20
EXPERIMENT_EXTRACTION_MAX_CHARS=60000

# How a project with no ProjectTaskProfile resolves its task set (P0-5).
#   all_tasks    — current default: inherit EVERY task definition. Since no route
#                  creates profile rows, this means a chemistry project also gets the
#                  recsys and BGC metric/dataset whitelists.
#   generic_only — resolve to generic.scholarly: empty vocabulary, empty datasets,
#                  universal metric core only.
# Flip to generic_only after checking measurement counts on a sample.
TASK_PROFILE_FALLBACK=all_tasks
# Read by BOTH the worker (governs extraction) and the API (reports the effective
# task set to the UI). Configure both identically or the UI will describe a task set
# the worker does not use. Check coverage first: paperforge-admin tasks coverage

# Narrative cross-study synthesis (P0-4). Default off: SYNTH bundles are then
# byte-identical to the deterministic ones and the writer prompt is unchanged.
# When on, each sub-question gains a [SYNTHESIS] block of claim/agreement/
# conditional/conflict/gap entries, every one of them bound to evidence ids from
# that same bundle. It never writes answer_status, evidence membership, or
# citations. One call per sub-question per distinct bundle; re-runs over an
# unchanged bundle cost nothing.
SYNTHESIS_LLM_ENABLED=false
SYNTHESIS_LLM_MAX_QUESTIONS=8

# Core-claim semantic verification rollout: off | shadow | promote_only | enforce.
# shadow only records verdicts. It is more blocking than promote_only, not less: promote_only
# cannot demote, but it clears core_claim_fulltext_missing blockers that shadow leaves in place.
CLAIM_ENTAILMENT_MODE=shadow

SCHOLAR_CONTACT_EMAIL=dev@example.com
SCHOLAR_USER_AGENT=PaperForge/0.1 (mailto:dev@example.com)
OPENALEX_API_KEY=

TEXD_URL=http://localhost:8081
TEXD_TIMEOUT_SECONDS=120
VISUALS_ENABLED=true
VISUALD_URL=http://localhost:8082
VISUALD_TIMEOUT_SECONDS=30

# Yunwu is the production/default image route. Without a key, the full pipeline
# keeps the graphical abstract as a retryable suggestion and makes no external call.
AI_IMAGES_ENABLED=true
IMAGE_PROVIDER=yunwu
YUNWU_API_BASE_URL=https://yunwu.ai/v1
YUNWU_API_KEY=
YUNWU_IMAGE_MODEL=gpt-image-1
YUNWU_IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_RETRIES=2

API_HOST=127.0.0.1
API_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3100
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_ENABLED=false
AUTH_DEV_LOGIN_ENABLED=true
AUTH_EMAIL_MODE=local
AUTH_EMAIL_OUTBOX_DIR=data/auth-outbox
