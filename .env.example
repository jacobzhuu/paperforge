# ==== PaperForge 环境变量示例 ====
# 复制为 .env 后填写。

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://paperforge:paperforge@localhost:15432/paperforge

# --- Redis / ARQ ---
REDIS_URL=redis://localhost:16379/0

# --- 对象存储（MinIO / S3 兼容） ---
STORAGE_BACKEND=filesystem       # filesystem | minio
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=paperforge
MINIO_SECRET_KEY=paperforge-secret
MINIO_BUCKET=paperforge
MINIO_SECURE=false
STORAGE_FS_ROOT=./data/objects

# --- LLM（OpenAI-compatible 多 provider；按角色路由，见 docs/design.md §4.9） ---
# provider 留 noop 时全部管线走确定性回退，仍能产出草稿（draft-first）。
LLM_DEFAULT_PROVIDER=noop
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
# 角色 → 模型映射（JSON）。按档位分配：便宜档做抽取/重排/软校验，强档做规划/写作/润色。
LLM_ROLE_MODELS={"planner":"gpt-4o-mini","extractor":"gpt-4o-mini","reranker":"gpt-4o-mini","writer":"gpt-4o","polisher":"gpt-4o","verifier":"gpt-4o-mini"}
# DeepSeek 示例（OpenAI 兼容端点）：
#   LLM_DEFAULT_PROVIDER=openai-compatible
#   LLM_OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_ROLE_MODELS={"planner":"deepseek-v4-pro","extractor":"deepseek-v4-flash","reranker":"deepseek-v4-flash","writer":"deepseek-v4-pro","polisher":"deepseek-v4-pro","verifier":"deepseek-v4-flash"}

# --- 学术检索适配器（礼貌 UA / 联系邮箱，OpenAlex/Crossref polite pool 需要） ---
SCHOLAR_CONTACT_EMAIL=you@example.com
SCHOLAR_USER_AGENT=PaperForge/0.1 (mailto:you@example.com)
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex 免费 key（openalex.org/settings/api）：日预算提升 10 倍
OPENALEX_API_KEY=

# --- Tectonic 编译沙箱 ---
TEXD_URL=http://localhost:8081
TEXD_TIMEOUT_SECONDS=120

# --- 视觉生成（图表/示意图始终与 AI 图片 provider 解耦） ---
VISUALS_ENABLED=true
AI_IMAGES_ENABLED=false
VISUALD_URL=http://localhost:8082
VISUALD_TIMEOUT_SECONDS=30
# 当前默认只接 Cloudflare Workers AI；保留统一 provider 配置以便后续接 GPT Image/Gemini/ComfyUI。
IMAGE_PROVIDER=cloudflare
IMAGE_BASE_URL=https://api.cloudflare.com/client/v4
IMAGE_API_KEY=
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Cloudflare Account ID（不是 API Token）；占位留空时 AI 按钮保持禁用。
IMAGE_ACCOUNT_ID=
IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_RETRIES=2

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- 账号与会话 ---
# 本地开发使用 HTTP cookie；生产必须改为 true，并由 HTTPS 站点提供服务。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
AUTH_IDLE_DAYS=7
# 登录/注册/找回密码依赖 Redis 限流；Redis 不可用时认证写接口会返回 503。
AUTH_RATE_LIMIT_ENABLED=true
# 仅限 localhost 开发：固定测试账号 admin / 123456；生产必须设为 false。
AUTH_DEV_LOGIN_ENABLED=true
PUBLIC_APP_URL=http://localhost:3000
# 本地 file 模式把验证/重置邮件写入 0600 文件，不把令牌写入日志。
AUTH_EMAIL_MODE=file
AUTH_EMAIL_OUTBOX_DIR=./data/auth-outbox

# 生产邮件（AUTH_COOKIE_SECURE=true 时 AUTH_EMAIL_MODE 必须为 smtp）：
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Web 运行时（部署平台环境变量；本地默认值无需设置） ---
# Next 服务端将同源 /api/v1 转发到此内部地址。生产浏览器不会直连跨域 API。
PAPERFORGE_API_INTERNAL_BASE=http://localhost:8080
# 仅开发构建可显式启用示例数据；生产构建无条件关闭。
NEXT_PUBLIC_DEMO_MODE=false
